diff --git a/core-v-mini-mcu.core b/core-v-mini-mcu.core
index f645e94..f445378 100644
--- a/core-v-mini-mcu.core
+++ b/core-v-mini-mcu.core
@@ -93,6 +93,7 @@ filesets:
     depend:
     - x-heep:x-heep:x-heep-fpga-support
     - use_hls_example ? (epfl:ip:dot_product)
+    - use_cim ? (hopcim:ip:cim_endpoint)
     files:
     - hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv
     file_type: systemVerilogSource
@@ -270,6 +271,53 @@ parameters:
       HLS) and pulls in epfl:ip:dot_product -- so without the flag,
       building/simulating X-HEEP never requires Vitis HLS to be installed.
     default: false
+  USE_CIM:
+    datatype: bool
+    paramtype: vlogdefine
+    description: |
+      Include the HopCIM endpoint (hopcim:ip:cim_endpoint, hw/ip/hopcim): on the testbench
+      external bus at 0xC0040000 in simulation, on the CPU data master's external-slave port
+      on the FPGA. Enable with `--flag use_cim`.
+    default: false
+  CIM_FE_DED:
+    datatype: bool
+    paramtype: vlogdefine
+    description: |
+      With USE_CIM: use the dedicated MFCC front-end baseline B3 (mfcc_ded) instead of the CIM
+      front-end (cim_fe). Enable with `--flag use_cim_ded` in addition to `--flag use_cim`.
+    default: false
+  USE_CIM_MIC:
+    datatype: bool
+    paramtype: vlogdefine
+    description: |
+      With USE_CIM on the Nexys A7: the HopCIM live audio path (R7) drives the on-board PDM
+      microphone (J5 clock, H5 data) instead of X-HEEP's pdm2pcm, and the system clock is
+      15.36 MHz (exactly 16 kHz audio). Enable with `--flag use_cim_mic`.
+    default: false
+  CIM_MIC_5M12:
+    datatype: bool
+    paramtype: vlogdefine
+    description: |
+      With USE_CIM_MIC: a 5.12 MHz system clock and PDM clock divider 5 instead of 15.36 MHz and 15,
+      the lowest clock with a 1.024 MHz PDM clock at which every hop is still processed in time.
+      Enable with `--flag use_cim_mic5` in addition to `--flag use_cim_mic`.
+    default: false
+  CIM_SEQ_S:
+    datatype: bool
+    paramtype: vlogdefine
+    description: |
+      With USE_CIM: the baseline S in the HopCIM sequencer (cim_endpoint SEQ_S): sign-gated
+      requantisation, a second requantisation lane, no L8 write to ACT. Enable with `--flag use_cim_s`.
+    default: false
+  CIM_MIC_4M096:
+    datatype: bool
+    paramtype: vlogdefine
+    description: |
+      With USE_CIM_MIC and CIM_SEQ_S: a 4.096 MHz system clock and PDM clock divider 4 (1.024 MHz PDM
+      clock, 16 kHz audio exactly). The MMCM makes 8.192 MHz (no MMCM output divider gives 4.096 MHz
+      from 100 MHz) and a BUFGCE passes every second edge. Enable with `--flag use_cim_mic4` in addition
+      to `--flag use_cim_mic` and `--flag use_cim_s`.
+    default: false
 
 scripts:
   # Build utils
@@ -361,6 +409,9 @@ targets:
     - COMMON_CELLS_ASSERTS_OFF
     - ASSERTS_OFF
     - use_hls_example ? (USE_HLS_EXAMPLE=true)
+    - use_cim ? (USE_CIM=true)
+    - use_cim_ded ? (CIM_FE_DED=true)
+    - use_cim_s ? (CIM_SEQ_S=true)
     tools:
       modelsim:
         vlog_options:
@@ -481,6 +532,12 @@ targets:
     - FPGA_SYNTHESIS=true
     - FPGA_NEXYS=true
     - NO_DDR_CLK_PORTS=true
+    - use_cim ? (USE_CIM=true)
+    - use_cim_ded ? (CIM_FE_DED=true)
+    - use_cim_mic ? (USE_CIM_MIC=true)
+    - use_cim_mic5 ? (CIM_MIC_5M12=true)
+    - use_cim_s ? (CIM_SEQ_S=true)
+    - use_cim_mic4 ? (CIM_MIC_4M096=true)
     tools:
       vivado:
         part: xc7a100tcsg324-1
