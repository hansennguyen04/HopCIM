# The X-HEEP that HopCIM is built on (sourced by xheep/*.sh).
XHEEP_UPSTREAM=https://github.com/x-heep/x-heep.git
XHEEP_COMMIT=b3eb3c8d626d3debe8e5cf99ecff32a5a31549fd
# git tree of that commit with xheep/patches/*.patch applied (independent of who applies them, and when)
XHEEP_SERIES_TREE=c9f4cf7c3bf690d4b8c948c60428aa63b8f5313a
# configuration for the generator (make mcu-gen X_HEEP_CFG=...); added by patch 0002
XHEEP_CFG=configs/kws_nexys.py
# the same with 256 KiB of RAM, for the CPU-only TensorFlow Lite Micro baseline (xheep/setup.sh <dest> <this>); patch 0005
XHEEP_CFG_256K=configs/kws_nexys_256k.py
# the same 256 KiB with a 180 KiB code section, for the second network's CPU-only baseline (TensorFlow Lite Micro, ResNet8); patch 0008
XHEEP_CFG_256K_C180=configs/kws_nexys_256k_c180.py
