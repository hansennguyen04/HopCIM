diff --git a/hw/fpga/xheep_fpga_support/scripts/nexys/xilinx_generate_clk_wizard_8m192.tcl b/hw/fpga/xheep_fpga_support/scripts/nexys/xilinx_generate_clk_wizard_8m192.tcl
new file mode 100644
index 0000000..9fd55b8
--- /dev/null
+++ b/hw/fpga/xheep_fpga_support/scripts/nexys/xilinx_generate_clk_wizard_8m192.tcl
@@ -0,0 +1,48 @@
+# Copyright 2026 X-HEEP contibutors
+# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
+# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
+# HopCIM live audio at its lowest real-time clock (use_cim_mic4): 8.192 MHz MMCM output without a buffer (exact: override mode), halved by a BUFGCE in the wrapper to 4.096 MHz: a 1.024 MHz
+# PDM clock (/4) and 16 kHz audio (/64) exactly. VCO = 100 MHz * 32 / 5 = 640 MHz, /78.125 (fractional, CLKOUT0).
+# Define design macros
+
+set design_name      xilinx_clk_wizard
+set in_clk_freq_MHz  100
+set out_clk_freq_MHz 8.192
+set out_clk_freq_Hz  8192000
+
+
+# Create block design
+create_bd_design $design_name
+
+# Create ports
+set clk_100MHz [ create_bd_port -dir I -type clk -freq_hz [ expr $in_clk_freq_MHz * 1000000 ] clk_100MHz ]
+set clk_out1_0 [ create_bd_port -dir O -type clk clk_out1_0 ]
+set_property -dict [ list CONFIG.FREQ_HZ $out_clk_freq_Hz ] $clk_out1_0
+
+# Create instance and set properties
+set clk_wiz_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:clk_wiz:6.0 clk_wiz_0 ]
+set_property -dict [ list \
+ CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {8.192} \
+ CONFIG.OVERRIDE_MMCM {true} \
+ CONFIG.CLKOUT1_DRIVES {No_buffer} \
+ CONFIG.MMCM_DIVCLK_DIVIDE {5} \
+ CONFIG.MMCM_CLKFBOUT_MULT_F {32.000} \
+ CONFIG.MMCM_CLKOUT0_DIVIDE_F {78.125} \
+ CONFIG.PRIM_IN_FREQ $in_clk_freq_MHz \
+ CONFIG.USE_LOCKED {false} \
+ CONFIG.USE_RESET {false} \
+] $clk_wiz_0
+
+# Create port connections
+# no output buffer: the feedback is wired here (the wizard then leaves clkfb_in open)
+if {[llength [get_bd_pins -quiet clk_wiz_0/clkfb_out]]} { connect_bd_net [get_bd_pins clk_wiz_0/clkfb_out] [get_bd_pins clk_wiz_0/clkfb_in] }
+connect_bd_net -net clk_in1_0_1 [ get_bd_ports clk_100MHz ] [ get_bd_pins clk_wiz_0/clk_in1 ]
+connect_bd_net -net clk_wiz_0_clk_out1 [ get_bd_ports clk_out1_0 ] [ get_bd_pins clk_wiz_0/clk_out1 ]
+
+# Save and close block design
+save_bd_design
+close_bd_design $design_name
+
+# create wrapper
+set wrapper_path [ make_wrapper -fileset sources_1 -files [ get_files -norecurse xilinx_clk_wizard.bd ] -top ]
+add_files -norecurse -fileset sources_1 $wrapper_path
diff --git a/hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv b/hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv
index ca0dbcd..e6371b5 100644
--- a/hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv
+++ b/hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv
@@ -329,10 +329,27 @@ module xilinx_core_v_mini_mcu_wrapper
       .clk_out1_0(clk_gen)
   );
 `elsif FPGA_NEXYS
+`ifdef CIM_MIC_4M096
+  // 4.096 MHz: no MMCM output divider reaches it from 100 MHz (only CLKOUT0 divides fractionally, and
+  // 4.096 MHz needs 156.25 > 128), so the MMCM makes 8.192 MHz without an output buffer, a BUFGCE passes
+  // every second rising edge, and a parallel BUFG clocks the enable's toggle. The MMCM output must not go
+  // through a BUFG first: X-HEEP's own BUFGMUX cascades on the system clock would then be one level too
+  // deep to place. Timing is analysed at 8.192 MHz, which is stricter.
+  wire clk_8m192_raw, clk_8m192;
+  logic clk_half_ce = 1'b0;
+  xilinx_clk_wizard_wrapper xilinx_clk_wizard_wrapper_i (
+      .clk_100MHz(clk_i),
+      .clk_out1_0(clk_8m192_raw)
+  );
+  BUFG bufg_8m192_i (.I(clk_8m192_raw), .O(clk_8m192));
+  always_ff @(posedge clk_8m192) clk_half_ce <= !clk_half_ce;
+  BUFGCE bufgce_4m096_i (.I(clk_8m192_raw), .CE(clk_half_ce), .O(clk_gen));
+`else
   xilinx_clk_wizard_wrapper xilinx_clk_wizard_wrapper_i (
       .clk_100MHz(clk_i),
       .clk_out1_0(clk_gen)
   );
+`endif
 `else  // FPGA PYNQ-Z2
   xilinx_clk_wizard_wrapper xilinx_clk_wizard_wrapper_i (
       .clk_125MHz(clk_i),
@@ -595,6 +612,26 @@ module xilinx_core_v_mini_mcu_wrapper
   xheep_obi_rsp_t [1:0] dotprod_gmem_obi_rsp;
 `endif
 
+`ifdef USE_CIM
+`ifdef USE_HLS_EXAMPLE
+  $error("USE_CIM and USE_HLS_EXAMPLE both use the CPU data master's external-slave port");
+`endif
+  // HopCIM endpoint (hw/ip/hopcim) on the CPU data master's external-slave port, a 1-to-1 tap:
+  // every CPU access to 0xC000_0000-0xFFFF_FFFF reaches it and it decodes addr[17:0], so the
+  // simulation address 0xC004_0000 works unchanged. Its interrupt is external line 3, as in
+  // the testharness.
+  xheep_obi_req_t cim_obi_req;
+  xheep_obi_rsp_t cim_obi_rsp;
+  logic           cim_irq;
+  logic [core_v_mini_mcu_pkg::NEXT_INT-1:0] cim_intr_vector;
+  logic cim_pdm_clk, cim_pdm_data;                     // HopCIM live audio path (R7)
+
+  always_comb begin
+    cim_intr_vector    = '0;
+    cim_intr_vector[3] = cim_irq;
+  end
+`endif
+
   x_heep_system #(
 `ifdef USE_HLS_EXAMPLE
       .EXT_XBAR_NMASTER(2)
@@ -602,7 +639,11 @@ module xilinx_core_v_mini_mcu_wrapper
   ) x_heep_system_i (
       .hart_id_i('0),
       .xheep_instance_id_i('0),
+`ifdef USE_CIM
+      .intr_vector_ext_i(cim_intr_vector),
+`else
       .intr_vector_ext_i('0),
+`endif
       .xif_compressed_if(ext_if),
       .xif_issue_if(ext_if),
       .xif_commit_if(ext_if),
@@ -667,6 +708,21 @@ module xilinx_core_v_mini_mcu_wrapper
       .ext_dma_write_resp_i('0),
       .ext_dma_addr_req_o(),
       .ext_dma_addr_resp_i('0),
+`elsif USE_CIM
+      .ext_xbar_master_req_i('0),
+      .ext_xbar_master_resp_o(),
+      .ext_core_instr_req_o(),
+      .ext_core_instr_resp_i('0),
+      .ext_core_data_req_o(cim_obi_req),
+      .ext_core_data_resp_i(cim_obi_rsp),
+      .ext_debug_master_req_o(),
+      .ext_debug_master_resp_i('0),
+      .ext_dma_read_req_o(),
+      .ext_dma_read_resp_i('0),
+      .ext_dma_write_req_o(),
+      .ext_dma_write_resp_i('0),
+      .ext_dma_addr_req_o(),
+      .ext_dma_addr_resp_i('0),
 `else
       .ext_xbar_master_req_i('0),
       .ext_xbar_master_resp_o(),
@@ -772,6 +828,10 @@ module xilinx_core_v_mini_mcu_wrapper
       .spi2_sck_io(spi2_sck_o),
       .pdm2pcm_clk_io,
       .pdm2pcm_pdm_io,
+`ifdef USE_CIM_MIC                                    // the HopCIM live audio path drives the microphone
+      .cim_pdm_clk_i (cim_pdm_clk),
+      .cim_pdm_data_o(cim_pdm_data),
+`endif
       .i2s_sck_io(i2s_sck_io),
