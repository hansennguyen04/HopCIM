 .../core-v-mini-mcu-fpga.core                 |  23 ++
 .../xilinx_generate_clk_wizard_15m36.tcl      |  44 ++++
 .../nexys/xilinx_generate_clk_wizard_5m12.tcl |  44 ++++
 .../xilinx_generate_clk_wizard_8m192.tcl      |  48 +++++
 hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv     | 104 +++++++++
 hw/system/x_heep_system.sv.tpl                |  23 +-
 ...02-hopcim-clock-filesets-and-scripts.patch | 198 ++++++++++++++++++
