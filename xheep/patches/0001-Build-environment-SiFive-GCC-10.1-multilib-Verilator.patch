diff --git a/sw/cmake/riscv.cmake b/sw/cmake/riscv.cmake
index dfd3984..ad60fe1 100644
--- a/sw/cmake/riscv.cmake
+++ b/sw/cmake/riscv.cmake
@@ -14,8 +14,8 @@
 
 # Author: Jose Miranda (jose.mirandacalero@epfl.ch)
 
-# set(RISCV_XHEEP  /home/$ENV{USER}/tools/riscv)
-set(RISCV_GITHUB_GCC_COMPILER  $ENV{RISCV_XHEEP}/bin/$ENV{COMPILER_PREFIX}elf-gcc)
+string(REGEX REPLACE "elf-$" "" CLEAN_COMPILER_PREFIX "$ENV{COMPILER_PREFIX}")
+set(RISCV_GITHUB_GCC_COMPILER  $ENV{RISCV_XHEEP}/bin/${CLEAN_COMPILER_PREFIX}elf-gcc)
 set(RISCV_GITHUB_CLANG_COMPILER  $ENV{RISCV_XHEEP}/bin/clang)
 #message("RISC-V GCC cross-compiler is in : ${RISCV_GCC_COMPILER}") 
 
@@ -52,8 +52,10 @@ endif()
 # The Generic system name is used for embedded targets (targets without OS) in
 # CMake
 set( CMAKE_SYSTEM_NAME          Generic )
-set( CMAKE_SYSTEM_PROCESSOR     $ENV{ARCH} 
-     CACHE STRING "Generate code for given RISC-V ISA string")
+set( CMAKE_TRY_COMPILE_TARGET_TYPE "STATIC_LIBRARY" )
+string(REGEX REPLACE "_zicsr" "" ARCH_FOR_GCC "$ENV{ARCH}")
+set( CMAKE_SYSTEM_PROCESSOR     ${ARCH_FOR_GCC} 
+     CACHE STRING "Generate code for given RISC-V ISA string" FORCE)
 set( CMAKE_EXECUTABLE_SUFFIX    ".elf")
 
 # specify the cross compiler. We force the compiler so that CMake doesn't
@@ -102,6 +104,9 @@ endif()
 # specify the C standard
 set( CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -g" )
 set( CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -march=${CMAKE_SYSTEM_PROCESSOR} ${COMPILER_FLAGS}" )
+if ("$ENV{ARCH}" MATCHES "rv32")
+     set( CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mabi=ilp32" )
+endif()
 if ($ENV{COMPILER} MATCHES "clang")
      set( CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wno-unused-command-line-argument --target=riscv32 --gcc-toolchain=$ENV{RISCV_XHEEP} --sysroot=$ENV{RISCV_XHEEP}/$ENV{COMPILER_PREFIX}elf" )
 endif()
diff --git a/tb/tb_top.cpp b/tb/tb_top.cpp
index 52416aa..c565caa 100644
--- a/tb/tb_top.cpp
+++ b/tb/tb_top.cpp
@@ -19,7 +19,7 @@ void runCycles(unsigned int ncycles, Vtestharness *dut, VerilatedFstC *m_trace){
     sim_time += CLK_PERIOD_ps/2;
     dut->clk_i ^= 1;
     dut->eval();
-    m_trace->dump(sim_time);
+    if (m_trace) m_trace->dump(sim_time);
   }
 }
 
@@ -38,10 +38,14 @@ int main (int argc, char * argv[])
   Vtestharness *dut = new Vtestharness;
 
   // Open VCD
-  Verilated::traceEverOn (true);
-  VerilatedFstC *m_trace = new VerilatedFstC;
-  dut->trace (m_trace, 99);
-  m_trace->open ("waveform.fst");
+  // Set XHEEP_NO_TRACE=1 to skip waveform dumping (much faster runs).
+  VerilatedFstC *m_trace = nullptr;
+  if (getenv("XHEEP_NO_TRACE") == nullptr) {
+    Verilated::traceEverOn (true);
+    m_trace = new VerilatedFstC;
+    dut->trace (m_trace, 99);
+    m_trace->open ("waveform.fst");
+  }
 
   XHEEP_CmdLineOptions* cmd_lines_options = new XHEEP_CmdLineOptions(argc,argv);
 
@@ -72,7 +76,7 @@ int main (int argc, char * argv[])
   dut->jtag_tdi_i           = 0;
 
   dut->eval();
-  m_trace->dump(sim_time);
+  if (m_trace) m_trace->dump(sim_time);
 
   dut->rst_ni               = 1;
   dut->boot_select_i        = boot_sel;
@@ -128,7 +132,7 @@ int main (int argc, char * argv[])
     exit_val = 2; // exit 2 to indicate successful run but premature termination
   }
 
-  m_trace->close();
+  if (m_trace) m_trace->close();
   delete dut;
   delete cmd_lines_options;
 
