@@ -0,0 +1,30 @@
+diff --git a/src/dmi_bscane_tap.sv b/src/dmi_bscane_tap.sv
+index 5fe5d86..a349933 100644
+--- a/src/dmi_bscane_tap.sv
++++ b/src/dmi_bscane_tap.sv
+@@ -44,6 +44,16 @@ module dmi_jtag_tap #(
+   input  logic        dmi_tdo_i
+ );
+ 
++  // Local patch (HopCIM): TCK is put on a global buffer. Left on local routing, its skew across
++  // the DTM registers is unchecked, and a placement change (e.g. a larger design) can break the
++  // debug module (OpenOCD: "Debug Module did not become active"). See constraints/common/bscan.xdc.
++  logic tck_bscan;
++
++  BUFG i_tck_bufg (
++    .I (tck_bscan),
++    .O (tck_o)
++  );
++
+   BSCANE2 #(
+     .JTAG_CHAIN (3)
+   ) i_tap_dtmcs (
+@@ -53,7 +63,7 @@ module dmi_jtag_tap #(
+     .RUNTEST (),
+     .SEL (dtmcs_select_o),
+     .SHIFT (shift_o),
+-    .TCK (tck_o),
++    .TCK (tck_bscan),
+     .TDI (tdi_o),
+     .TMS (),
+     .TDO (dtmcs_tdo_i),
