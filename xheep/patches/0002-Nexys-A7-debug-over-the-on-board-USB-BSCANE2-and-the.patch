diff --git a/tb/core-v-mini-mcu-nexys-bscan.cfg b/tb/core-v-mini-mcu-nexys-bscan.cfg
new file mode 100644
index 0000000..2868a92
--- /dev/null
+++ b/tb/core-v-mini-mcu-nexys-bscan.cfg
@@ -0,0 +1,53 @@
+# OpenOCD config: X-HEEP on Nexys A7-100T, debug through the on-board USB.
+# Requires a bitstream built with FUSESOC_FLAGS=--flag=use_bscane_xilinx, which
+# places the RISC-V DTM behind the Artix-7 BSCANE2 USER3 (dtmcs) and USER4
+# (dmi) registers. No external JTAG adapter is needed: the Nexys A7's FT2232H
+# channel A (the one Vivado uses to program the FPGA) drives the FPGA JTAG.
+# Adapted from core-v-mini-mcu-pynq-z2-bscan.cfg.
+
+adapter driver ftdi
+adapter speed 1000
+transport select jtag
+
+# Digilent on-board FT2232H (same layout as interface/ftdi/digilent-hs1.cfg)
+ftdi_vid_pid 0x0403 0x6010
+ftdi_channel 0
+ftdi_layout_init 0x0088 0x008b
+
+reset_config none
+
+echo "ftdi setting..."
+
+# Artix-7 XC7A100T: IR length 6, IDCODE 0x?3631093 (version nibble ignored)
+set _CHIPNAME riscv
+jtag newtap $_CHIPNAME cpu -irlen 6 -ignore-version -expected-id 0x03631093
+
+set _TARGETNAME $_CHIPNAME.cpu
+target create $_TARGETNAME riscv -chain-position $_TARGETNAME -coreid 0x000
+
+echo "target created..."
+
+log_output openocd_fpga.log
+
+# 7-series instruction codes: IDCODE 0x09, USER3 0x22, USER4 0x23
+riscv set_ir idcode 0x09
+riscv set_ir dtmcs 0x22
+riscv set_ir dmi 0x23
+
+riscv set_reset_timeout_sec 2000
+riscv set_command_timeout_sec 2000
+
+# prefer to use sba for system bus access
+riscv set_prefer_sba off
+
+echo "setting preferences..."
+
+scan_chain
+
+init
+
+echo "init routine started"
+
+halt
+
+echo "Ready for Remote Connections"
diff --git a/tb/nexys-a7-program-fpga.cfg b/tb/nexys-a7-program-fpga.cfg
new file mode 100644
index 0000000..6e3e832
--- /dev/null
+++ b/tb/nexys-a7-program-fpga.cfg
@@ -0,0 +1,18 @@
+# OpenOCD config: program the Nexys A7-100T FPGA over the on-board USB.
+# Usage (from the x-heep root):
+#   openocd -f tb/nexys-a7-program-fpga.cfg -c "pld load 0 <bitstream.bit>" -c shutdown
+# Alternative to Vivado's hw_server; do not run both at the same time.
+
+adapter driver ftdi
+adapter speed 10000
+transport select jtag
+
+ftdi_vid_pid 0x0403 0x6010
+ftdi_channel 0
+ftdi_layout_init 0x0088 0x008b
+
+reset_config none
+
+source [find cpld/xilinx-xc7.cfg]
+
+init
