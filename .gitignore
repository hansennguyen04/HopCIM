# Generated by the simulators and Vivado. Keep sources, vectors, reports and run logs.
__pycache__/
*.pyc
.Xil/
clockInfo.txt
vivado*.jou
vivado*.log
# Verilator and xsim
/sim/obj_*/
/sim/bin/
/sim/work_*/
/sim/xsim_*/*
!/sim/xsim_*/run.log
/sim/build_*.log
/sim/lint_*.log
/sim/obj_*
# Vivado out-of-context runs: keep the scripts and reports only
/syn/**
!/syn/**/
!/syn/**/*.tcl
!/syn/**/*.xdc
!/syn/**/*.rpt
!/syn/**/*.md
!/syn/**/*.sh
!/syn/vivado_miscompile/**
/syn/netlist/
sim/regression.log
/model/rule_sweep/
/sim/cov/
/sim/endpoint_nl.out
/model/defines_run/pickles/
/tb/seq_vec_all/
