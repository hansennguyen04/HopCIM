# Found by X-HEEP's FuseSoC through the symlink planenest/hw/x-heep/hw/ip/hopcim -> hopcim/.

name: "hopcim:ip:cim_endpoint"
description: "HopCIM digital CIM engine (FPGA emulation) behind an X-HEEP OBI slave port."

filesets:
  files_rtl:
    depend:
    - x-heep:rtl:structs
    files:
    - rtl/fe_tables.svh: {is_include_file: true}
    - rtl/ded_tables.svh: {is_include_file: true}
    - rtl/wp_tables.svh: {is_include_file: true}
    - rtl/pdm_tables.svh: {is_include_file: true}
    - rtl/cim_engine.sv
    - rtl/cim_fe.sv
    - rtl/mfcc_ded.sv
    - rtl/cim_log2fix16.sv
    - rtl/cim_seq.sv
    - rtl/pdm_dec.sv
    - rtl/cim_audio.sv
    - rtl/cim_endpoint.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
    - files_rtl
